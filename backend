<?php
header("Content-Type: application/json");
require 'config.php'; // contém define('OPENAI_API_KEY', 'sua_nova_chave');

$mensagem = $_POST['message'] ?? '';

if (!$mensagem) {
    echo json_encode(['reply' => 'Mensagem vazia.']);
    exit;
}

$data = [
    "model" => "gpt-4o-mini",
    "messages" => [
        ["role" => "system", "content" => "Você é a Recimind, assistente de reciclagem."],
        ["role" => "user", "content" => $mensagem]
    ]
];

$ch = curl_init("https://api.openai.com/v1/chat/completions");
curl_setopt_array($ch, [
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_POST => true,
    CURLOPT_HTTPHEADER => [
        "Authorization: Bearer " . OPENAI_API_KEY,
        "Content-Type: application/json"
    ],
    CURLOPT_POSTFIELDS => json_encode($data)
]);

$response = curl_exec($ch);
curl_close($ch);

$result = json_decode($response, true);
$reply = $result['choices'][0]['message']['content'] ?? "Não consegui gerar resposta.";
echo json_encode(['reply' => $reply]);
